/*
 * SlabBoard — left half (BLE central, trackpad)
 *
 * SPDX-License-Identifier: MIT
 */

#include "slabboard.dtsi"

&kscan0 {
    /*
     * COL 0 (outer pinky) -> COL 5 (inner index).
     *
     * Reversed relative to the right half. Both halves are wired the same way
     * physically -- P1.06 is the INNER (index) column and P0.31 the OUTER
     * (pinky) column on each -- and one is flipped over, so they are mirror
     * images. Keymap columns run left to right across the whole board, so the
     * outer pinky is COL 0 here but COL 11 on the right; hence this list is
     * reversed and the right half's is not.
     *
     * Verified on hardware: with this list in P1.06-first order the left hand
     * typed its rows backwards.
     */
    col-gpios
        = <&gpio0 31 GPIO_ACTIVE_HIGH>   /* COL 0  P0.31  outer pinky */
        , <&gpio0 29 GPIO_ACTIVE_HIGH>   /* COL 1  P0.29 */
        , <&gpio0  2 GPIO_ACTIVE_HIGH>   /* COL 2  P0.02 */
        , <&gpio1 15 GPIO_ACTIVE_HIGH>   /* COL 3  P1.15 */
        , <&gpio0  9 GPIO_ACTIVE_HIGH>   /* COL 4  P0.09 */
        , <&gpio1  6 GPIO_ACTIVE_HIGH>   /* COL 5  P1.06  inner index */
        ;
};

/*
 * Azoteq TPS65 trackpad, on TWIM0.
 *
 * Driver: AYM1607/zmk-driver-azoteq-iqs5xx, pulled in by config/west.yml.
 * Its README lists the TPS65 as tested. The full property list lives in that
 * module at dts/bindings/input/azoteq,iqs5xx-common.yaml.
 *
 * i2c0 is safe to use here: it shares a peripheral ID with spi0, and this half
 * drives no SPI — the nice!view is on the right half's spi3.
 */
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,    /* SDA  P0.17 */
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;    /* SCL  P0.20 */
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <400000>;
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    trackpad: iqs5xx@74 {
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        status = "okay";

        rdy-gpios   = <&gpio1 11 GPIO_ACTIVE_HIGH>;   /* RDY  P1.11 */
        reset-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;    /* RST  P1.13 */

        /*
         * RST is active low on the IQS5xx, which is why this is GPIO_ACTIVE_LOW
         * (matching the driver's own example). At init the driver asserts it,
         * waits 1 ms, releases and waits 10 ms, so the pad starts from a known
         * state rather than whatever it was left in.
         */

        /*
         * X is inverted relative to how the pad is mounted -- verified on
         * hardware: moving a finger left moved the pointer right, while Y was
         * already correct. flip-x sets IQS5XX_FLIP_X in the chip's own XY
         * config register, so the pad reports corrected coordinates rather
         * than the driver negating them afterwards.
         */
        flip-x;

        one-finger-tap;
        two-finger-tap;
        press-and-hold;
        press-and-hold-time = <250>;
        scroll;
    };
};

/ {
    trackpad_listener: trackpad_listener {
        compatible = "zmk,input-listener";
        device = <&trackpad>;

        /*
         * Axis direction is handled on the trackpad node above (flip-x), not
         * here -- the driver's switch-xy / flip-x / flip-y are applied inside
         * the IQS5xx itself. Input processors remain available for anything
         * the driver cannot express.
         * See https://zmk.dev/docs/keymaps/input-processors
         */
        // input-processors = <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)>;
    };
};
