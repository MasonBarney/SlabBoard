/*
 * SlabBoard — keymap
 *
 * 5 rows x 12 columns, 60 keys. Left half is columns 0-5 (outer pinky to
 * inner index), right half columns 6-11 (inner index to outer pinky), so
 * each row below reads straight across the keyboard left to right.
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/* Custom Device-tree */
&mt {
    tapping-term-ms = <275>;
    flavor = "tap-preferred";
    quick-tap-ms = <200>;
    require-prior-idle-ms = <150>;
};
&lt {
    tapping-term-ms = <275>;
    flavor = "tap-preferred";  
};

/* custom macro definitions */
/ {
    macros {

        // selects all and then does caps - for wisetime
        cap_in_Chrome: cap_in_Chrome {
            label = "&CAP_IN_CHROME";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>
                , <&kp LG(A)>
                , <&macro_wait_time 100>
                , <&macro_tap>
                , <&kp LG(LA(N1))>;
        };

        maching_parentheses: maching_parentheses {
            label = "&MACHING_PARENTHESES";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>
                , <&kp LS(N9)>
                , <&macro_tap>
                , <&kp LS(N0)>
                , <&macro_tap>
                , <&kp SPACE>
                , <&macro_tap>
                , <&kp LEFT>
                , <&kp LEFT>;
        };

        maching_brakets: maching_brakets {
            label = "&MACHING_BRAKETS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>
                , <&kp LBKT>
                , <&macro_tap>
                , <&kp RBKT>
                , <&macro_tap>
                , <&kp LEFT>
                , <&macro_wait_time 15>
                , <&macro_tap>
                , <&caps_word>;
        };

        maching_quotes: maching_quotes {
            label = "&MACHING_QUOTES";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>
                , <&kp SQT>
                , <&macro_tap>
                , <&kp SQT>
                , <&macro_tap>
                , <&kp LEFT>;
        };

        Paste_Unformatted_Word: Paste_Unformatted_Word {
            label = "&PASTE_UNFORMATTED_WORD";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(V))>
                , <&macro_wait_time 200>
                , <&kp U>
                , <&macro_tap_time 100>
                , <&kp RET>;
        };
    };
};

/* custom behaiors definitions */
/ {
    behaviors {

        // a mt for a parenthesis macro
        matchingholdP: matchingholdP {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&maching_parentheses>, <&kp>;
            flavor = "tap-preferred";
            quick-tap-ms = <200>;
            hold-trigger-on-release;
        };

        macro_hold_tap: macro_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&maching_brakets>, <&maching_parentheses>;
            flavor = "tap-preferred";
            quick-tap-ms = <200>;
        };

        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        paste_unformatted_word: paste_unformatted_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&Paste_Unformatted_Word>, <&kp LG(LA(LS(V)))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

            default_layer {
                display-name = "Base";
                bindings = <
                    &kp ESC       &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp MINUS
                    &kp EQUAL     &kp Q         &kp W         &kp E         &kp R         &kp T         &mt LG(Y) Y  &mt LG(U) U  &mt LG(I) I    &mt LG(O) O &kp P     &kp BSLH
                    &kp TAB       &mt LG(A) A  &kp S     &kp D     &mt LG(F) F      &kp G         &kp H         &kp J         &kp K         &kp L         &kp SEMI      &kp SQT
                    &bspc_del  &mt LG(Z) Z  &mt LG(X) X   &mt LG(C) C &mt LG(V) V  &mt LG(B) B         &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH      &kp GRAVE
                    &kp LGUI      &kp LALT      &mo 3         &mo 1         &kp LSHIFT    &kp LGUI      &mt LG(RET) RET         &kp SPACE       &mo 2         &mo 3         &kp RALT      &kp LC(ESC)
                >;
                    sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            };
            lower_layer {
                display-name = "Lower";
                bindings = <
                    &kp GRAVE     &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &kp DEL
                    &trans        &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp F11
                    &trans        &trans        &trans        &trans        &trans        &trans        &kp LA(LEFT)    &mt LA(LEFT) LEFT      &kp DOWN       &kp UP       &mt LA(RIGHT) RIGHT           &kp LA(RIGHT)
                    &trans        &trans        &cap_in_Chrome         &paste_unformatted_word  &kp LC(LA(LG(M)))        &trans        &trans        &trans        &trans        &kp END       &kp PG_UP     &kp PG_DN
                    &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
                >;
                    sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
            };
            raise_layer {
                display-name = "Raise";
                bindings = <
                    &kp TILDE     &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT     &kp CARET     &kp AMPS      &kp ASTRK     &kp LPAR      &kp RPAR      &kp DEL
                    &trans        &trans        &trans        &trans        &trans        &trans        &kp MINUS     &kp EQUAL     &kp LBKT      &kp RBKT      &kp BSLH      &kp GRAVE
                    &trans        &trans        &trans        &trans        &trans        &trans        &kp UNDER     &kp PLUS      &kp LBRC      &kp RBRC      &kp PIPE      &kp TILDE
                    &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
                    &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
                >;
                    sensor-bindings = <&inc_dec_kp C_NEXT C_PREV>;
            };
            adjust_layer {
                display-name = "Adjust";
                bindings = <
                    &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans        &trans        &trans        &trans        &trans        &sys_reset
                    &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &bootloader
                    &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
                    &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
                    &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
                >;
                    sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
            };
    };
};
